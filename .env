# =============================================================================
# Semillas del Algarrobo - variables de entorno
# Copiá este archivo como .env y completá los valores. NUNCA subas .env a git.
# =============================================================================

# --- Django ---
DJANGO_DEBUG=True
# Obligatoria en producción. Generala con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# En producción / túnel: https://tu-dominio.org (separados por coma)
DJANGO_CSRF_TRUSTED_ORIGINS=

# URL pública del sitio, sin barra final. Mercado Pago redirige aquí al donador
# después de pagar. Para pruebas locales usá un túnel HTTPS (ver README).
SITE_URL=http://127.0.0.1:8000
SITE_NAME=Semillas del Algarrobo

# --- Mercado Pago ---
# Credenciales en: https://www.mercadopago.com.ar/developers/panel/app
# Pruebas: credenciales de PRUEBA (o de producción de una cuenta de prueba).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# "Clave secreta" de Tus integraciones > Webhooks (valida la firma x-signature).
MERCADOPAGO_WEBHOOK_SECRET=
# Tolerancia en segundos para el timestamp de la firma (0 = sin control).
MERCADOPAGO_WEBHOOK_TOLERANCE=0
MERCADOPAGO_CURRENCY=ARS
MERCADOPAGO_STATEMENT_DESCRIPTOR=SEMILLAS ALG

# --- Donación única ---
DONATION_PRESET_AMOUNTS=5000,10000,20000,50000
DONATION_MIN_AMOUNT=500
DONATION_MAX_AMOUNT=5000000

# --- Redes sociales ---
SOCIAL_INSTAGRAM_URL=https://www.instagram.com/semillasdelalgarrobo/
SOCIAL_FACEBOOK_URL=https://www.facebook.com/asistenciasolidariaelalgarrobo/

# --- Imágenes ---
COMMUNITY_IMAGE_MAX_MB=8
